/**
 * Free Summit – booking form + booking API receiver (Google Apps Script)
 *
 * What it does: every booking request is added as a row to the Google Sheet this
 * script is attached to, and you get an email. Replying to that email replies
 * straight to the client. Requests come from two places:
 *   - the website form (column "Page" = home, guia, via-ferrata, ...)
 *   - AI agents / apps using the booking API (column "Page" = api, or "api: <agent name>")
 *     Docs for them: https://freesummitpt.com/api/  (generated by tools/build_pages.py)
 *
 * First-time setup (signed in as admin@freesummitpt.com):
 *  1. Create a Google Sheet, e.g. "Booking Requests".
 *  2. In the Sheet: Extensions → Apps Script. Delete the sample code and paste this file.
 *  3. Deploy → New deployment → type "Web app". Execute as: Me · Who has access: Anyone.
 *     Authorise when asked (Google warns the app is unverified: Advanced → Go to project).
 *  4. Copy the Web app URL (ends in /exec) into assets/config.js → formEndpoint.
 *
 * Updating this script later (keeps the same URL, so nothing on the website changes):
 *  paste the new version over the old one → Save → Deploy → Manage deployments →
 *  pencil (Edit) → Version: "New version" → Deploy. If Google asks for permission again,
 *  accept: this version reads the activity list from freesummitpt.com.
 */

const NOTIFY_EMAIL = 'admin@freesummitpt.com';
const SHEET_NAME = 'Requests';   // the tab in the Booking Requests sheet where rows are added
const SITE = 'https://freesummitpt.com';
const SPEC_URL = SITE + '/api/booking.json';
const FIELDS = ['name', 'email', 'phone', 'activity', 'date', 'people', 'type', 'transfer', 'message', 'lang', 'source'];
const MAX_PER_EMAIL_PER_HOUR = 5;   // API only: stops an agent stuck in a loop from flooding the sheet

/** Opening the URL in a browser (GET): short info for agents. */
function doGet() {
  return json_({
    ok: true,
    service: 'Free Summit booking requests',
    how: 'POST JSON or form fields to this URL. Required: name, email, activity.',
    docs: SITE + '/api/',
    openapi: SPEC_URL
  });
}

function doPost(e) {
  const isJson = !!(e && e.postData && /json/i.test(e.postData.type || ''));
  let p = {};
  if (isJson) {
    try { p = JSON.parse(e.postData.contents || '{}') || {}; }
    catch (err) { return json_({ ok: false, errors: [{ field: 'body', message: 'Body is not valid JSON.' }] }); }
  } else {
    p = (e && e.parameter) || {};
  }
  if (p.website) return json_({ ok: true }); // spam trap filled in: ignore silently

  // The website form always sends "source" (the page name) as form fields. Anything else is the API.
  const fromWebsite = !isJson && !!p.source && !p.agent;
  const clean = {};
  Object.keys(p).forEach(k => { clean[k] = String(p[k] == null ? '' : p[k]).trim().slice(0, 2000); });

  if (!fromWebsite) {
    // API requests: check everything and say clearly what is wrong.
    const errors = validate_(clean);
    if (errors.length) return json_({ ok: false, errors: errors, docs: SITE + '/api/' });
    if (tooMany_(clean.email)) {
      return json_({ ok: false, errors: [{ field: 'email', message: 'Too many requests for this email in the last hour. Please email hello@freesummitpt.com instead.' }] });
    }
    clean.source = 'api' + (clean.agent ? ': ' + clean.agent.slice(0, 100) : '');
    clean.type = clean.type || 'Shared group';
    clean.transfer = clean.transfer || 'No transfer';
    clean.people = clean.people || '2';
    clean.lang = clean.lang || 'en';
  }
  // Website requests are never rejected here: the browser cannot show an error from this script,
  // so a rejected request would be a lost client. The form checks name, email and activity itself.

  const id = 'FS-' + Utilities.formatDate(new Date(), 'Europe/Lisbon', 'yyyyMMdd') + '-' +
             Utilities.getUuid().slice(0, 4).toUpperCase();

  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sheet = ss.getSheetByName(SHEET_NAME);
    if (!sheet) {
      sheet = ss.insertSheet(SHEET_NAME);
      sheet.appendRow(['Received', 'Name', 'Email', 'Phone', 'Activity', 'Date', 'People',
                       'Type', 'Transfer', 'Message', 'Language', 'Page', 'Status']);
      sheet.setFrozenRows(1);
    }
    const row = [new Date()].concat(FIELDS.map(f => clean[f] || ''), ['New']);
    sheet.appendRow(row);
  } finally {
    lock.releaseLock();
  }

  const lines = FIELDS.map(f => f.charAt(0).toUpperCase() + f.slice(1) + ': ' + (clean[f] || '—'));
  MailApp.sendEmail({
    to: NOTIFY_EMAIL,
    replyTo: clean.email || NOTIFY_EMAIL,
    subject: (fromWebsite ? 'Novo pedido: ' : 'Novo pedido (API): ') + (clean.activity || 'actividade') + ' – ' + (clean.name || ''),
    body: 'Ref: ' + id + '\n' + lines.join('\n') + '\n\nVer todos os pedidos: ' + SpreadsheetApp.getActiveSpreadsheet().getUrl()
  });

  return json_({
    ok: true,
    id: id,
    status: 'received',
    message: 'Request received. Free Summit will reply to ' + (clean.email || 'the client') +
             ' within 24 hours with availability and the price. The booking is confirmed when the client ' +
             'replies to accept.'
  });
}

function validate_(p) {
  const errors = [];
  const add = (field, message) => errors.push({ field: field, message: message });
  if (!p.name) add('name', 'Required.');
  if (!p.email) add('email', 'Required.');
  else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(p.email)) add('email', 'Not a valid email address.');

  const opts = options_();
  if (!p.activity) add('activity', 'Required. One of: ' + (opts.activity || []).join(' | '));
  else if (opts.activity && opts.activity.indexOf(p.activity) < 0) add('activity', 'Unknown activity. Use one of: ' + opts.activity.join(' | '));
  if (p.type && opts.type && opts.type.indexOf(p.type) < 0) add('type', 'Use one of: ' + opts.type.join(' | '));
  if (p.transfer && opts.transfer && opts.transfer.indexOf(p.transfer) < 0) add('transfer', 'Use one of: ' + opts.transfer.join(' | '));

  if (p.date) {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(p.date);
    const d = m && new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
    const today = Utilities.formatDate(new Date(), 'Europe/Lisbon', 'yyyy-MM-dd');
    if (!d || isNaN(d) || d.getUTCDate() !== +m[3]) add('date', 'Use the format YYYY-MM-DD.');
    else if (p.date < today) add('date', 'The date is in the past.');
  }
  if (p.people && !(/^\d+$/.test(p.people) && +p.people >= 1 && +p.people <= 20)) add('people', 'A whole number from 1 to 20.');
  if (p.lang && ['en', 'pt'].indexOf(p.lang) < 0) add('lang', 'Use en or pt.');
  return errors;
}

/** Allowed values, read from the website's API description (cached 1 hour). Never blocks if the site is unreachable. */
function options_() {
  const cache = CacheService.getScriptCache();
  const hit = cache.get('options');
  if (hit) return JSON.parse(hit);
  try {
    const spec = JSON.parse(UrlFetchApp.fetch(SPEC_URL, { muteHttpExceptions: true }).getContentText());
    const props = spec.paths[Object.keys(spec.paths)[0]].post.requestBody.content['application/json'].schema.properties;
    const opts = { activity: props.activity.enum, type: props.type.enum, transfer: props.transfer.enum };
    cache.put('options', JSON.stringify(opts), 3600);
    return opts;
  } catch (err) {
    console.error('Could not read the activity list from ' + SPEC_URL + ': ' + err); // see Apps Script → Executions
    return {}; // site unreachable: accept the values as sent
  }
}

function tooMany_(email) {
  const cache = CacheService.getScriptCache();
  const key = 'n:' + email.toLowerCase();
  const n = Number(cache.get(key) || 0) + 1;
  cache.put(key, String(n), 3600);
  return n > MAX_PER_EMAIL_PER_HOUR;
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
